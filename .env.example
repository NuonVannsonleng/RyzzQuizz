# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Surfaced by /api/health so you can prove which instance served a request
INSTANCE_ID=local

# PostgreSQL — used by auth (server/src/services/authService.ts) only. Live
# room/session state is still in-memory; see server/src/db/schema.sql.
#
# For Supabase: Project Settings -> Database -> Connection info. Use the
# session/direct connection (port 5432), not the transaction pooler — this is
# a long-running server, not serverless.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
# TLS is on unless set to "false". Hosted Postgres requires it; a plain local
# server without TLS needs DB_SSL=false.
DB_SSL=true

# Signs the login session cookie. Any long random string; regenerating it
# logs everyone out. Required in production — see middleware/auth.ts.
JWT_SECRET=

# Set true in production so ENABLE_DEV_TOOLS/dev mode is force-disabled.
NODE_ENV=development

# Redis — required before running more than one instance (see README)
# REDIS_URL=redis://host:6379
